# TEMPLATE – copy to .env (cp wsl.linux.env .env) and adjust, see README.md
# Required under WSL2 only (bridges ROCm with /dev/dxg); harmless on native Linux.
HSA_ENABLE_DXG_DETECTION=1
# Configured for RX 7900 XTX (RDNA 3). Change according to the table in README.md.
HSA_OVERRIDE_GFX_VERSION=11.0.0
